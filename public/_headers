/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://static.cloudflareinsights.com; frame-src 'self' https://www.google.com https://maps.google.com

/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# Markdown mirrors. RFC 7763 media type, and Vary: Accept so a CDN never hands
# the HTML variant to a client that negotiated for markdown (see
# functions/_middleware.js).
# A single "*" matches across path segments, so this covers nested mirrors too
# (/window-cleaning/burleigh-heads/index.md). A "/**/*.md" rule is NOT valid
# Cloudflare _headers syntax — wrangler rejects it.
/*.md
  Content-Type: text/markdown; charset=utf-8
  Vary: Accept, Accept-Encoding
  Cache-Control: public, max-age=3600
  X-Robots-Tag: index, follow

# OpenAPI document (also served live at /api/v1/openapi.json). Open CORS so a
# browser-based client or a spec viewer can load it.
/openapi.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# RFC 9727 API catalog — a Linkset (RFC 9264) naming every API on this host.
/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# The MCP manifest has no file extension, so declare its type explicitly.
/.well-known/mcp
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# HTML pages are content-negotiable too — same cache-key requirement.
/
  Vary: Accept, Accept-Encoding

/*/
  Vary: Accept, Accept-Encoding
